[Unit]
Description=igmpwatch - passive IGMP snooping security monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust WorkingDirectory to wherever the package lives.
WorkingDirectory=/opt/igmpwatch
ExecStart=/usr/bin/python3 -m igmpwatch -c /etc/igmpwatch/igmpwatch.yaml
Restart=on-failure
RestartSec=5

# Needs raw-socket capture but nothing else. Run unprivileged + capability.
User=igmpwatch
Group=igmpwatch
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true

# Sandbox: this process only reads packets and writes its DB/log.
ProtectSystem=strict
ReadWritePaths=/var/lib/igmpwatch /var/log/igmpwatch
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_PACKET AF_UNIX AF_NETLINK
MemoryMax=128M

[Install]
WantedBy=multi-user.target
